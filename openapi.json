        ],
        "summary": "Search Papers Post",
        "operationId": "search_papers_post_v1_papers_search_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaperSearchRequest"
              }
            }
