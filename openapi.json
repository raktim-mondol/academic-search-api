{
  "openapi": "3.1.0",
  "info": {
    "title": "Unified Academic Search Database API",
    "description": "Agent-ready REST & Model Context Protocol (MCP) API aggregating OpenAlex, Semantic Scholar, Crossref, arXiv, PubMed/Europe PMC, PMC BioC, PubTator 3.0, DOAJ, DBLP, INSPIRE-HEP, Unpaywall, OpenCitations, and commercial academic databases for paper search, journal metrics, BibTeX, abstract reconstruction, and full-text PDF context extraction.",
    "version": "1.0.0"
  },
